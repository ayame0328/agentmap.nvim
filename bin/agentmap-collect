#!/usr/bin/env python3
# ============================================================
#  agentmap-collect -- recorder called by Claude Code hooks (part of agentmap.nvim)
#
#  Usage   : agentmap-collect [--root DIR | --root=DIR]   (hook payload JSON on stdin)
#            agentmap-collect --root DIR --steer [--mode stop|deny|context] [--at-stop] [--record]
#                             [--pause --max-wait SECONDS] [--handback relay|deny]
#  Input   : one hook payload (JSON) on stdin
#  Output  : one line appended to <root>/projects/<slug>/runs/<session_id>/hooks.jsonl
#  --steer : deliver pending steering instructions (<run>/steer/<target>-<ms>.json, written by
#            Neovim). --mode stop (the default since 0.1.2): only when the agent tries to finish
#            (SubagentStop / Stop, decision "block"); PreToolUse then only waits for a pause.
#            --mode deny / context: also just before the next tool (PreToolUse); at SubagentStop /
#            Stop only with --at-stop (the v0.1.1 registration) or right after a pause released it.
#            Prints the hook's JSON answer on stdout only when something was delivered, and records
#            the delivery as one hooks.jsonl line (DESIGN-v0.1.2-steer2 §3).
#            Without --record it writes no ordinary record (the recording hook is separate).
#  --pause : before delivering, wait inside the hook while a pause request
#            <run>/pause/<target>.json (written by Neovim) exists: PreToolUse (at = "next") and
#            SubagentStop / Stop (any at). Polls every 100 ms; the deadline (auto-resume) is kept by
#            the hook itself in <target>.hit.json, --max-wait caps one wait. Records hit / released /
#            aborted lines in hooks.jsonl. Resuming without an instruction prints nothing (DESIGN-v0.1.2-pause).
#            At SessionEnd the recorder removes the pause files of that run (and <root>/pause.pending when no
#            pause file is left anywhere), so a pause that never stopped the agent cannot outlive the session.
#  Hand-back (DESIGN-v0.1.2-handback §3.2): a sub-agent that reports through the SubagentHandback tool
#            (Claude Code's auto mode) ends its turn with that tool, and Claude Code discards any block after it.
#            For such a sub-agent SubagentStop never blocks or waits: pending instructions stay pending and a
#            "skipped" steer line is written; a pause request is removed ("released", reason handback_end).
#            The end of such a sub-agent is PreToolUse:SubagentHandback, handled only by the hook registered
#            with the matcher SubagentHandback and "--handback relay|deny": it waits for a pause of any "at",
#            and with "deny" hands pending instructions over as the deny reason (a tool result). The matcher-less
#            PreToolUse hook (no --handback) leaves SubagentHandback alone, so nothing waits twice.
#  Root    : --root -> $AGENTMAP_DIR -> $AGENTFLOW_DIR (deprecated) ->
#            $XDG_DATA_HOME/nvim/agentflow -> ~/.local/share/nvim/agentflow
#            (the folder name stays "agentflow" so existing records keep working)
#
#  Guarantees
#    - Always exits 0 and never prints anything except the --steer answer (must never
#      disturb Claude Code). Unknown arguments are ignored. Failures go to <root>/collector.log only.
#    - Keeps only the fields it needs; full prompts and full tool inputs are not stored.
#      Secrets that look like keys or passwords are redacted.
#    - Python 3 standard library only; no external commands (speed).
#    - The writing convention ([Goal] / 【目的】 ...) is parsed with the same rules as
#      lua/agentmap/brief.lua (parity test: tests/fixtures/convention_cases.jsonl).
# ============================================================
import sys
import os
import json
import re
import datetime
import signal
import time

MAX_LINE = 8000          # 1 行の上限（バイト）。超えたら長い項目から削る
MAX_LINE_BIG = 16000     # 報告（report）や質問（questions）を持つ行だけの上限。中身が長いのが当たり前なので別枠
HEAD = 200               # 依頼文・最終メッセージの先頭何文字を残すか
TARGET = 120             # ファイル名・コマンドの上限文字数
WRITE_TOOLS = ("Write", "Edit", "MultiEdit", "NotebookEdit")
# 長さの上限（文字数）。lua/agentmap/brief.lua の LIMITS と同じ数にしてある（画面と記録で切り方をそろえる）
BRIEF = 300              # 【目的】【任せる理由】【期待する結果】の各 1 項目
ASK_Q = 300              # AskUserQuestion の question（と答えの値 1 つ）
ASK_LABEL = 60           # option の label（header も同じ長さで切る）
ASK_DESC = 240           # option の description
ASK_QUESTIONS = 4        # 1 回の AskUserQuestion の question の数
ASK_OPTIONS = 6          # 1 問あたりの option の数
REPORT = 2000            # 子の報告の本文
REPORT_SHRUNK = 800      # 行が長すぎるときに報告を縮める長さ
REPORT_TAIL = 65536      # 子の transcript の末尾何バイトから報告を探すか
# 書き方の決まり（親の指示の 3 行）。日本語と英語の両方を受ける。英語は大文字小文字を無視（ASCII の範囲だけ）
BRIEF_KEYS = (("purpose", "【目的】", "[Goal]"), ("reason", "【任せる理由】", "[Why delegate]"),
              ("expected", "【期待する結果】", "[Done when]"))
BRIEF_EN = {k: re.compile(re.escape(en), re.IGNORECASE | re.ASCII) for k, _ja, en in BRIEF_KEYS}
# 値の終わり：次の改行・次の「【」・次の英語のマーカー
BRIEF_STOP = re.compile("\n|【|" + "|".join(re.escape(en) for _k, _ja, en in BRIEF_KEYS), re.IGNORECASE | re.ASCII)
TASK_TEXT = 60           # 手順表（TaskCreate）の subject / activeForm の上限文字数（brief.lua の LIMITS.step_text と同じ）
TASK_LIST = 50           # TaskList の一覧を何件まで残すか
STEER_TEXT = 4000        # 修正指示の本文の上限文字数
STEER_BYTES = 16384      # これより大きい未配達ファイルは読まない（4000 文字 × UTF-8 の最大 4 バイト）
# 次の道具の直前（mode deny / context）で届けるときの文。出所と時機だけを言う。「tool error ではない」「試験ではない」の
# ような、モデルに疑わせないための言い回しは書かない（安全の仕組みをごまかす方向の文は持たない。DESIGN-v0.1.2-steer2 §3.3・§10）
STEER_HEAD = "[AgentMap] Steering instruction from the user, typed in Neovim (AgentMap) while you were working:"
STEER_TAIL = "Follow it from now on, then continue your task."
# 終わり際（SubagentStop / Stop の block）で届けるときの文（DESIGN-v0.1.2-steer2 §3.3）。Claude Code はこれを
# "Stop hook feedback" として user の行に入れる（ツールの結果ではない）
STEER_HEAD_STOP = ("[AgentMap] Instruction from the user, typed in Neovim (AgentMap) while you were working. "
                   "It reaches you now, just before you finish:")
STEER_TAIL_STOP = "Apply it now, continue your task, then finish again."
STEER_MODES = ("stop", "deny", "context")
# 報告を SubagentHandback で返す子に、その直前（PreToolUse:SubagentHandback の deny）で届けるときの文
# （DESIGN-v0.1.2-handback §3.3。任意設定 steer.handback = "deny"）。出所と時機だけ。疑わせない言い回しは書かない
STEER_HEAD_HANDBACK = ("[AgentMap] Instruction from the user, typed in Neovim (AgentMap) while you were working. "
                       "It reaches you now, just before you hand back your report:")
STEER_TAIL_HANDBACK = "Apply it now, continue your task, then call SubagentHandback again with your updated report."
HANDBACK_TOOL = "SubagentHandback"
HANDBACK_ROUTES = ("relay", "deny")
# 親への「子が報告を返した」知らせ（UserPromptSubmit の prompt。2.1.29x 実測 H12）
AGENT_MESSAGE = re.compile(r'^\s*<agent-message from="([A-Za-z0-9_-]{1,128})">')
HANDBACK_NOTICE = "[Subagent hand-back]"
# 子（ROOT 以外）への文の最後に足す 1 文（親にも知らせるため、報告に書いてもらう。DESIGN-v0.2-steer 付録 E）
STEER_TAIL_CHILD = "Mention this instruction and what you changed because of it in your final report."
# 一時停止（DESIGN-v0.1.2-pause §3）
PAUSE_BYTES = 4096       # 止まれファイルの上限。超えたら読まない（止まらない側に倒す）
PAUSE_TICK = 0.1         # 待っている間、止まれファイルを見る間隔（秒）
PAUSE_AUTO = 600         # auto_resume_s が無いときの期限（秒）
PAUSE_AUTO_MIN, PAUSE_AUTO_MAX = 5, 86400
# 止まれから解けて指示を届けるとき、見出しの次に足す 1 行（英語固定）
PAUSE_LINE = "(You were paused by the user for %s before this instruction.)"
COMMON = ("session_id", "hook_event_name", "cwd", "transcript_path",
          "prompt_id", "agent_id", "agent_type")


def root_arg(argv):
    """--root DIR / --root=DIR を読む。無ければ None。知らない引数は無視する"""
    for i, a in enumerate(argv):
        if a == "--root" and i + 1 < len(argv) and argv[i + 1]:
            return argv[i + 1]
        if a.startswith("--root=") and len(a) > len("--root="):
            return a[len("--root="):]
    return None


def root_dir(argv=None):
    """保存先のいちばん上のフォルダ。--root → AGENTMAP_DIR → AGENTFLOW_DIR（旧名）→ XDG → ~/.local/share"""
    d = root_arg(argv if argv is not None else sys.argv[1:])
    if d:
        return os.path.expanduser(d)
    for env in ("AGENTMAP_DIR", "AGENTFLOW_DIR"):
        d = os.environ.get(env)
        if d:
            return d
    x = os.environ.get("XDG_DATA_HOME")
    if x:
        return os.path.join(x, "nvim", "agentflow")
    return os.path.join(os.path.expanduser("~"), ".local", "share", "nvim", "agentflow")


def slug_of(d):
    """プロジェクトの名札。Claude 自身のフォルダ名（transcript の親フォルダ名）をそのまま使う"""
    tp = d.get("transcript_path")
    if isinstance(tp, str) and tp:
        s = os.path.basename(os.path.dirname(tp))
        if s:
            return s
    return re.sub(r"[^A-Za-z0-9]", "-", str(d.get("cwd") or "unknown"))


def safe_name(s):
    """フォルダ名に使えない文字を消す（session_id に / などが混ざっても外へ出ない）"""
    return re.sub(r"[^A-Za-z0-9._-]", "_", str(s or "unknown"))[:128] or "unknown"


SECRET_KV = re.compile(r"(?i)((?:api[_-]?key|access[_-]?key|token|secret|password|passwd|authorization)[\"']?\s*[=:]\s*[\"']?(?:bearer\s+)?|bearer\s+)[^\s\"']+")
SECRET_TOK = re.compile(r"\b(?:sk-[A-Za-z0-9_-]{8,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_\w{20,}|AKIA[0-9A-Z]{16}|xox[abprs]-[\w-]{10,}|AIza[\w-]{30,})")


def redact(s):
    """鍵やパスワードらしい部分を *** にする（記録に秘密を残さないため）"""
    if not isinstance(s, str):
        return s
    return SECRET_TOK.sub("***", SECRET_KV.sub(lambda m: m.group(1) + "***", s))


def head(s, n=HEAD):
    """先頭 n 文字だけ。改行は空白にする。鍵らしい部分は伏せる"""
    if not isinstance(s, str):
        return None
    return redact(s[:n * 4]).replace("\r", " ").replace("\n", " ")[:n]


def clip(s, n):
    """先頭 n 文字だけ。head() と違って改行は残す（報告は見出しと箇条書きの形が意味を持つため）。鍵らしい部分は伏せる"""
    if not isinstance(s, str):
        return None
    return redact(s[:n * 4])[:n]


def parse_brief(text):
    """依頼文から 3 項目を抜く（brief.lua の parse_brief と同じ規則）。
    マーカーは 【目的】/[Goal]・【任せる理由】/[Why delegate]・【期待する結果】/[Done when]（英語は大文字小文字を無視）。
    同じ項目は日本語・英語のうち先に出てきた方。値はマーカーの直後から「次の改行」「次の【」「次の英語のマーカー」まで。
    前後の空白とマーカー直後のコロンを落とし、300 文字で切る。1 つも無ければ None（そのときは brief のキー自体を付けない）"""
    if not isinstance(text, str) or not text:
        return None
    out = {}
    for k, ja, _en in BRIEF_KEYS:
        cands = []
        i = text.find(ja)
        if i >= 0:
            cands.append((i, i + len(ja)))
        m = BRIEF_EN[k].search(text)
        if m:
            cands.append((m.start(), m.end()))
        if not cands:
            continue
        rest = text[min(cands)[1]:]
        stop = BRIEF_STOP.search(rest)
        v = (rest[:stop.start()] if stop else rest).strip()
        # Lua と同じく「：」→「:」の順に 1 つずつ落としてから空白を落とす
        if v.startswith("："):
            v = v[1:]
        if v.startswith(":"):
            v = v[1:]
        v = v.strip()
        if v:
            out[k] = redact(v)[:BRIEF]
    return out or None


def ask_input(ti):
    """AskUserQuestion の入力から、question / header / multiSelect / options(label, description) だけ残す。
    個数と長さは上の定数で切る（質問の中身は画面に出すために残すが、行が際限なく長くならないように）"""
    qs = ti.get("questions") if isinstance(ti, dict) else None
    if not isinstance(qs, list):
        return {}
    out = []
    for q in qs[:ASK_QUESTIONS]:
        if not isinstance(q, dict):
            continue
        r = {}
        if isinstance(q.get("question"), str):
            r["question"] = clip(q["question"], ASK_Q)
        if isinstance(q.get("header"), str):
            r["header"] = clip(q["header"], ASK_LABEL)
        if q.get("multiSelect") is not None:
            r["multiSelect"] = bool(q.get("multiSelect"))
        opts = []
        for o in (q.get("options") if isinstance(q.get("options"), list) else [])[:ASK_OPTIONS]:
            if not isinstance(o, dict):
                continue
            oo = {}
            if isinstance(o.get("label"), str):
                oo["label"] = clip(o["label"], ASK_LABEL)
            if isinstance(o.get("description"), str):
                oo["description"] = clip(o["description"], ASK_DESC)
            opts.append(oo)
        r["options"] = opts
        out.append(r)
    return {"questions": out}


def ask_answers(tr):
    """AskUserQuestion の答え（{質問文: 答え}）。答えは文字列でも配列でもそのまま。値ごとに 300 文字で切る"""
    a = tr.get("answers") if isinstance(tr, dict) else None
    if not isinstance(a, dict):
        return None
    out = {}
    for k, v in a.items():
        key = clip(str(k), ASK_Q)
        if isinstance(v, list):
            out[key] = [clip(x, ASK_Q) if isinstance(x, str) else x for x in v]
        elif isinstance(v, str):
            out[key] = clip(v, ASK_Q)
        elif v is not None:
            out[key] = clip(str(v), ASK_Q)
    return out


def handback_report(path):
    """子の transcript の末尾から、最後の SubagentHandback の message を取る。無ければ None。
    SubagentStop の last_assistant_message は handback の後の一言か空なので、報告の本文はここにしか無い。
    SubagentStop の時点で transcript は最後まで書かれている（2026-10-01 実測 6 件）"""
    if not isinstance(path, str) or not path:
        return None
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            off = max(0, size - REPORT_TAIL)
            f.seek(off)
            data = f.read()
    except Exception:
        return None
    lines = data.split(b"\n")
    if off > 0 and lines:
        lines = lines[1:]  # 途中から始まる 1 行目は捨てる
    for raw in reversed(lines):
        if b'"name":"SubagentHandback"' not in raw or b'"type":"assistant"' not in raw:
            continue
        try:
            t = json.loads(raw)
        except Exception:
            continue
        content = ((t.get("message") or {}).get("content")) if isinstance(t, dict) else None
        for b in reversed(content if isinstance(content, list) else []):
            if isinstance(b, dict) and b.get("type") == "tool_use" and b.get("name") == "SubagentHandback":
                m = (b.get("input") or {}).get("message")
                if isinstance(m, str) and m.strip():
                    return m
    return None


def handback_ended(d, hb):
    """SubagentStop の子が SubagentHandback で番を終えたか（DESIGN-v0.1.2-handback §3.1 の印③）。
    hb は handback_report() の結果。handback で終わった子の payload には last_assistant_message が無い（H2）。
    handback の後にモデルが何か言った（last_assistant_message がある）なら、番は道具で終わっていない"""
    if hb is None:
        return False
    last = d.get("last_assistant_message")
    return not (isinstance(last, str) and last.strip())


def tail(s, n=TARGET):
    """長いファイル名は後ろを残して先頭を … にする"""
    if not isinstance(s, str):
        return None
    return s if len(s) <= n else "…" + s[-(n - 1):]


def now_iso():
    t = datetime.datetime.now(datetime.timezone.utc)
    return t.strftime("%Y-%m-%dT%H:%M:%S.") + "%03dZ" % (t.microsecond // 1000)


def agent_input(ti):
    """Agent ツールの入力から、残してよい項目だけ取り出す"""
    if not isinstance(ti, dict):
        return {}
    out = {}
    for k in ("description", "subagent_type", "model", "isolation"):
        if ti.get(k) is not None:
            out[k] = ti.get(k)
    if isinstance(ti.get("prompt"), str):
        out["prompt_head"] = head(ti["prompt"])
        b = parse_brief(ti["prompt"])
        if b:
            out["brief"] = b
    return out


def read_meta(d):
    """SubagentStart のとき、Claude 自身が書いた agent-<id>.meta.json を読めたら読む（無くてもよい）"""
    tp, sid, aid = d.get("transcript_path"), d.get("session_id"), d.get("agent_id")
    if not (isinstance(tp, str) and sid and aid):
        return None
    sub = os.path.join(os.path.dirname(tp), str(sid), "subagents")
    name = "agent-%s.meta.json" % aid
    m, wf = None, None
    try:
        with open(os.path.join(sub, name), "rb") as f:
            m = json.loads(f.read(4096))
    except Exception:
        m = None
    if m is None:
        # Workflow から起動された Agent は subagents/workflows/<wf_id>/ の下に置かれる（1 段だけ見る）
        wf_root = os.path.join(sub, "workflows")
        try:
            names = sorted(os.listdir(wf_root))
        except Exception:
            names = []
        for w in names:
            p = os.path.join(wf_root, w, name)
            if os.path.exists(p):
                try:
                    with open(p, "rb") as f:
                        m = json.loads(f.read(4096))
                    wf = w
                except Exception:
                    m = None
                break
    if not isinstance(m, dict):
        return None
    out = {}
    for k in ("toolUseId", "parentAgentId", "model", "description", "spawnDepth", "agentType", "workflowPhase"):
        if m.get(k) is not None:
            out[k] = m[k]
    if wf:
        out["wf_id"] = wf
    return out or None


def task_notification_head(prompt):
    """<task-notification> の依頼文は、task-id と status だけ残す"""
    tid = re.search(r"<task-id>.*?</task-id>", prompt, re.S)
    st = re.search(r"<status>.*?</status>", prompt, re.S)
    return head(" ".join(x.group(0) for x in (tid, st) if x))


def build(d):
    """hook の中身から、保存する 1 行（辞書）を作る"""
    ev = d.get("hook_event_name")
    rec = {k: d[k] for k in COMMON if d.get(k) is not None}
    tool = d.get("tool_name")

    if ev == "SessionStart":
        if d.get("source") is not None:
            rec["source"] = d["source"]
    elif ev == "UserPromptSubmit":
        p = d.get("prompt")
        if isinstance(p, str):
            m = AGENT_MESSAGE.match(p)
            if p.lstrip().startswith("<task-notification>"):
                rec["kind"] = "task_notification"
                rec["prompt_head"] = task_notification_head(p)
            elif m and HANDBACK_NOTICE in p[:1000]:
                # 子が SubagentHandback で報告を返した知らせ（DESIGN-v0.1.2-handback §3.2）。from はその子の agent id
                rec["kind"] = "agent_message"
                rec["from"] = m.group(1)
                rec["prompt_head"] = head(p)
            else:
                rec["prompt_head"] = head(p)
        # 権限モード（"auto" なら子は SubagentHandback で報告を返す見込み。H1・H11）。このイベントと SubagentStop だけ
        if isinstance(d.get("permission_mode"), str):
            rec["permission_mode"] = d["permission_mode"][:40]
    elif ev == "PreToolUse":
        rec["tool_use_id"] = d.get("tool_use_id")
        rec["tool_name"] = tool
        if tool == "Agent":
            rec["tool_input"] = agent_input(d.get("tool_input"))
        elif tool == "AskUserQuestion":
            rec["tool_input"] = ask_input(d.get("tool_input"))
        elif tool == "Workflow" and isinstance(d.get("tool_input"), dict):
            desc = d["tool_input"].get("description")
            if desc is not None:
                rec["tool_input"] = {"description": head(desc) if isinstance(desc, str) else desc}
        elif tool == HANDBACK_TOOL:
            # 子が返そうとしている報告（関門で止めている間に読めるように。SubagentStop の report と同じ扱い）
            ti = d.get("tool_input") if isinstance(d.get("tool_input"), dict) else {}
            if isinstance(ti.get("message"), str) and ti["message"].strip():
                rec["report"] = clip(ti["message"], REPORT)
    elif ev == "PostToolUse":
        rec["tool_use_id"] = d.get("tool_use_id")
        rec["tool_name"] = tool
        if d.get("duration_ms") is not None:
            rec["duration_ms"] = d["duration_ms"]
        ti = d.get("tool_input") if isinstance(d.get("tool_input"), dict) else {}
        tr = d.get("tool_response")
        if tool == "Agent":
            rec["tool_input"] = agent_input(ti)
            if isinstance(tr, dict):
                rec["tool_response"] = {k: tr[k] for k in
                                        ("agentId", "resolvedModel", "status", "isAsync", "description")
                                        if tr.get(k) is not None}
        elif tool == "AskUserQuestion":
            rec["tool_input"] = ask_input(ti)
            ans = ask_answers(tr)
            if ans is not None:
                rec["tool_response"] = {"answers": ans}
        elif tool == "Workflow":
            # 台本（script）の中身は保存しない。説明・再開元・起動結果の札だけ
            rec["tool_input"] = {k: ti[k] for k in ("description", "resumeFromRunId") if ti.get(k) is not None}
            if isinstance(tr, dict):
                rec["tool_response"] = {k: tr[k] for k in ("status", "taskId", "runId", "workflowName")
                                        if tr.get(k) is not None}
                if isinstance(tr.get("summary"), str):
                    rec["tool_response"]["summary"] = head(tr["summary"], 120)
        elif tool == "SendMessage":
            # 親経由の修正指示が渡った事実（宛先 to）。本文は先頭 120 文字だけ、tool_response は残さない
            # （DESIGN-v0.1.2-steer2 §4.5。2.1.291 の payload は to / recipient、message / content の両方を持つ）
            to = ti.get("to") if isinstance(ti.get("to"), str) and ti.get("to") else ti.get("recipient")
            rec["tool_input"] = {k: v for k, v in (("to", to if isinstance(to, str) else None),
                                                   ("head", head(ti.get("message") if isinstance(ti.get("message"), str)
                                                                 else ti.get("content"), 120)),
                                                   ("summary", head(ti.get("summary"), 120))) if v is not None}
        elif tool in WRITE_TOOLS:
            rec["target"] = tail(ti.get("file_path") or ti.get("notebook_path"))
        elif tool == "Bash":
            c = ti.get("command")
            if isinstance(c, str):
                rec["target"] = redact(c.strip().split("\n", 1)[0])[:TARGET]
        elif tool in ("EnterWorktree", "ExitWorktree"):
            rec["target"] = json.dumps(ti, ensure_ascii=False, separators=(",", ":"))[:TARGET]
            if tr is not None:
                rec["response_head"] = str(tr)[:TARGET]
        elif tool == "TaskCreate":
            # 手順表（進み具合の事実）。description は長く画面に要らないので保存しない
            rec["tool_input"] = {k: clip(ti.get(k), TASK_TEXT) for k in ("subject", "activeForm")
                                 if isinstance(ti.get(k), str)}
            if isinstance(tr, dict) and isinstance(tr.get("task"), dict) and tr["task"].get("id") is not None:
                rec["tool_response"] = {"task": {"id": str(tr["task"].get("id")),
                                                 "subject": clip(tr["task"].get("subject"), TASK_TEXT)}}
        elif tool == "TaskUpdate":
            rec["tool_input"] = {k: (str(ti.get(k)) if k == "taskId" else ti.get(k)) for k in ("taskId", "status")
                                 if ti.get(k) is not None and (k == "taskId" or isinstance(ti.get(k), str))}
            if isinstance(tr, dict) and isinstance(tr.get("statusChange"), dict):
                rec["tool_response"] = {"taskId": str(tr.get("taskId") if tr.get("taskId") is not None else ti.get("taskId")),
                                        "statusChange": {k: tr["statusChange"].get(k) for k in ("from", "to")
                                                         if isinstance(tr["statusChange"].get(k), str)}}
        elif tool == "TaskList":
            tasks = tr.get("tasks") if isinstance(tr, dict) and isinstance(tr.get("tasks"), list) else []
            rec["tool_response"] = {"tasks": [{"id": str(t.get("id")), "subject": clip(t.get("subject"), TASK_TEXT),
                                               "status": t.get("status") if isinstance(t.get("status"), str) else None}
                                              for t in tasks[:TASK_LIST] if isinstance(t, dict) and t.get("id") is not None]}
    elif ev == "PostToolUseFailure":
        rec["tool_use_id"] = d.get("tool_use_id")
        rec["tool_name"] = tool
        e = d.get("error")
        if not isinstance(e, str):
            e = d.get("stderr") if isinstance(d.get("stderr"), str) else (None if e is None else str(e))
        if e is not None:
            rec["error_head"] = head(e)
    elif ev == "SubagentStart":
        m = read_meta(d)
        if m:
            rec["meta"] = m
    elif ev == "SubagentStop":
        if d.get("agent_transcript_path") is not None:
            rec["agent_transcript_path"] = d["agent_transcript_path"]
        if isinstance(d.get("last_assistant_message"), str):
            rec["last_head"] = head(d["last_assistant_message"])
        # 子の報告：handback の message があればそれ、無ければ最後の返答（handback を使わずに終わった子）
        hb = handback_report(d.get("agent_transcript_path"))
        rep = hb
        if rep is None and isinstance(d.get("last_assistant_message"), str) and d["last_assistant_message"].strip():
            rep = d["last_assistant_message"]
        if rep is not None:
            rec["report"] = clip(rep, REPORT)
        if handback_ended(d, hb):
            rec["report_via"] = "handback"
        if isinstance(d.get("permission_mode"), str):
            rec["permission_mode"] = d["permission_mode"][:40]
    elif ev == "Stop":
        if isinstance(d.get("last_assistant_message"), str):
            rec["last_head"] = head(d["last_assistant_message"])
    elif ev == "SessionEnd":
        if d.get("reason") is not None:
            rec["reason"] = d["reason"]

    rec = {k: v for k, v in rec.items() if v is not None}
    rec["_v"] = 1
    rec["_ts"] = now_iso()
    rec["_src"] = "claude_hook"
    return rec


def encode(rec):
    """1 行にする。長すぎたら prompt_head → last_head → target → report（800 に縮める → 消す）
    → 質問の description（消す）→ 2 問目以降の質問（消す）の順に削る。
    上限は報告か質問を持つ行だけ MAX_LINE_BIG、ほかは MAX_LINE"""
    def dump():
        return json.dumps(rec, ensure_ascii=False, separators=(",", ":")).encode("utf-8")

    ti = rec.get("tool_input") if isinstance(rec.get("tool_input"), dict) else {}
    qs = ti.get("questions") if isinstance(ti.get("questions"), list) else None
    limit = MAX_LINE_BIG if ("report" in rec or qs is not None) else MAX_LINE

    def drop_key(k):
        rec.pop(k, None)
        ti.pop(k, None)

    def shrink_report():
        if isinstance(rec.get("report"), str):
            rec["report"] = rec["report"][:REPORT_SHRUNK]

    def drop_desc():
        for q in qs or []:
            for o in q.get("options") or []:
                o.pop("description", None)

    def drop_more_questions():
        if qs:
            del qs[1:]

    def shrink_tasks():
        tr = rec.get("tool_response")
        if isinstance(tr, dict) and isinstance(tr.get("tasks"), list):
            del tr["tasks"][20:]

    steps = [lambda: drop_key("prompt_head"), lambda: drop_key("last_head"), lambda: drop_key("target"),
             shrink_report, lambda: rec.pop("report", None), drop_desc, drop_more_questions, shrink_tasks]
    line = dump()
    for step in steps:
        if len(line) <= limit:
            break
        step()
        line = dump()
    return line


def append(path, data):
    """O_APPEND で 1 回の write。複数の hook が同時に書いても行が混ざらない"""
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        os.write(fd, data + b"\n")
    finally:
        os.close(fd)


def write_project(pdir, d, slug):
    """project.json（どのフォルダの記録か）を書き換える。途中で切れないよう tmp → rename"""
    p = os.path.join(pdir, "project.json")
    tmp = p + ".tmp.%d" % os.getpid()
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump({"cwd": d.get("cwd"), "slug": slug, "updated_at": now_iso()}, f, ensure_ascii=False)
    os.replace(tmp, p)


def opt_value(argv, name):
    """--name VALUE / --name=VALUE を読む。無ければ None"""
    for i, a in enumerate(argv):
        if a == name and i + 1 < len(argv):
            return argv[i + 1]
        if a.startswith(name + "="):
            return a[len(name) + 1:]
    return None


def log_error(root, e, ev):
    """失敗は自分用の記録（collector.log）にだけ残す"""
    try:
        if root:
            os.makedirs(root, exist_ok=True)
            line = json.dumps({"ts": now_iso(), "error": (type(e).__name__ + ": " + str(e))[:300], "event": ev},
                              ensure_ascii=False).encode("utf-8")
            append(os.path.join(root, "collector.log"), line)
    except Exception:
        pass


def steer_message(texts, child=False, paused_ms=None, at_stop=False, handback=False):
    """モデルに渡す文（英語固定。本文だけ作者の言語）。子への文には報告に書く頼みを足す。
    止まれから解けて届けるときは、止まっていた時間の 1 行を見出しの次に足す。
    at_stop（SubagentStop / Stop の block）は終わり際用の見出しと結び（DESIGN-v0.1.2-steer2 §3.3）。
    handback（PreToolUse:SubagentHandback の deny）は報告の直前用の見出しと結び（DESIGN-v0.1.2-handback §3.3）"""
    extra = (PAUSE_LINE % dur_text(paused_ms) + "\n") if paused_ms is not None else ""
    if handback:
        h, t = STEER_HEAD_HANDBACK, STEER_TAIL_HANDBACK
    elif at_stop:
        h, t = STEER_HEAD_STOP, STEER_TAIL_STOP
    else:
        h, t = STEER_HEAD, STEER_TAIL
    return h + "\n" + extra + "\n\n".join(texts) + "\n" + t + (" " + STEER_TAIL_CHILD if child else "")


def dur_text(ms):
    """ミリ秒 → "45 s" / "2 min 31 s" / "1 h 5 min"（英語固定）"""
    sec = int(round(max(0, ms or 0) / 1000.0))
    if sec < 60:
        return "%d s" % sec
    if sec < 3600:
        return "%d min %d s" % (sec // 60, sec % 60)
    return "%d h %d min" % (sec // 3600, (sec % 3600) // 60)


def iso_of(epoch):
    """epoch 秒 → "2026-10-05T12:10:06Z"（UTC）"""
    return datetime.datetime.fromtimestamp(epoch, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def target_of(d):
    """宛先の名前（子は agent_id、ROOT は "ROOT"）。steer と pause で同じ"""
    return d.get("agent_id") if isinstance(d.get("agent_id"), str) and d.get("agent_id") else "ROOT"


def hook_line(run, d, extra):
    """配達・一時停止の 1 行を hooks.jsonl に書く（記録係の行と同じ作り。道具の入力は残さない）"""
    rec = {k: d[k] for k in ("session_id", "hook_event_name", "tool_name", "tool_use_id", "agent_id", "prompt_id")
           if d.get(k) is not None}
    rec.update(extra)
    rec["_v"] = 1
    rec["_ts"] = now_iso()
    rec["_src"] = "claude_hook"
    append(os.path.join(run, "hooks.jsonl"), json.dumps(rec, ensure_ascii=False, separators=(",", ":")).encode("utf-8"))


def max_wait_arg(argv):
    """--max-wait N（秒）。無い・読めないときは None（期限だけで待つ）"""
    v = opt_value(argv, "--max-wait")
    try:
        n = float(v)
    except (TypeError, ValueError):
        return None
    return n if n >= 0 else None


def read_pause(pf):
    """止まれファイルを読む。(中身, st) か、読まない理由を ValueError で返す。無ければ (None, None)"""
    try:
        st = os.stat(pf)
    except OSError:
        return None, None
    if st.st_size > PAUSE_BYTES:
        raise ValueError("pause file too big: %d bytes" % st.st_size)
    with open(pf, "rb") as f:
        obj = json.loads(f.read(PAUSE_BYTES + 1))
    if not isinstance(obj, dict) or not isinstance(obj.get("id"), str) or not obj.get("id"):
        raise ValueError("pause file without id")
    return obj, st


def same_file(pf, st0):
    """止まれファイルが、待ち始めたときと同じもの（消えていない・別の止まれに置き換わっていない）か"""
    try:
        st = os.stat(pf)
    except OSError:
        return False
    return (st.st_ino, st.st_dev) == (st0.st_ino, st0.st_dev)


def claim_hit(side, pause, auto, d, ev):
    """止まった印（<target>.hit.json）を O_EXCL で作る。作れたら (deadline, True)。
    既にあれば中身の期限を引き継ぐ (deadline, False)。前の止まれの残り（id が違う）は作り直す"""
    now = time.time()
    body = {"id": pause["id"], "hit_at": now_iso(), "deadline": int(now + auto), "hit_event": ev}
    for k in ("tool_name", "tool_use_id"):
        if d.get(k) is not None:
            body[k] = d[k]
    for _ in range(2):
        try:
            fd = os.open(side, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            try:
                with open(side, "rb") as f:
                    old = json.loads(f.read(PAUSE_BYTES))
            except Exception:
                old = None  # 相手が書いている途中など。期限は今から数える
            if isinstance(old, dict) and old.get("id") not in (None, pause["id"]):
                try:
                    os.remove(side)  # 別の（前の）止まれの印の残り
                except OSError:
                    pass
                continue
            dl = old.get("deadline") if isinstance(old, dict) else None
            return (float(dl) if isinstance(dl, (int, float)) else now + auto), False
        try:
            os.write(fd, json.dumps(body, ensure_ascii=False).encode("utf-8"))
        finally:
            os.close(fd)
        return float(body["deadline"]), True
    return now + auto, False


def pause_file_names(root):
    """どの run にも止まれファイル（<target>.json。.hit.json と書きかけの .tmp.* は除く）があるか"""
    import glob
    for f in glob.glob(os.path.join(root, "projects", "*", "runs", "*", "pause", "*.json")):
        if not f.endswith(".hit.json"):
            return True
    return False


def clear_pause_flag(root):
    """hook が自分で止まれを消したあと（期限・上限）、ほかに止まれが無ければ <root>/pause.pending を消す。
    Neovim が閉じていると印が残り、全セッションの道具 1 回ごとに Python が起動し続けるため。
    Neovim は「止まれファイルを書く → 印を作る」の順なので、消した後にもう一度見て、あれば印を作り直す"""
    flag = os.path.join(root, "pause.pending")
    try:
        if not os.path.exists(flag) or pause_file_names(root):
            return
        os.remove(flag)
        if pause_file_names(root):
            os.close(os.open(flag, os.O_WRONLY | os.O_CREAT, 0o600))
    except OSError:
        pass


def end_session_cleanup(root, run):
    """SessionEnd（記録係）：この run の止まれファイル（<target>.json と <target>.hit.json）を片付け、ほかに止まれが
    無ければ <root>/pause.pending も消す。Neovim を閉じたまま、止まれが届く前（REQUESTED）にセッションが Stop を
    経ずに終わった（Esc のあと /exit など）とき、待っていた hook が SIGTERM で死んだときの取り残しを防ぐ
    （残ると全セッションの道具 1 回ごとに Python が起動し続ける）。GATE は Neovim の印なので触らない"""
    pdir = os.path.join(run, "pause")
    try:
        names = os.listdir(pdir)
    except OSError:
        names = []
    for n in names:
        if n.endswith(".json"):
            try:
                os.remove(os.path.join(pdir, n))
            except OSError:
                pass
    clear_pause_flag(root)


def pause_wait(root, d, run, argv, at_end=False):
    """止まれがあれば hook の中で待つ（DESIGN-v0.1.2-pause §3.2）。
    at_end: PreToolUse:SubagentHandback（handback の子の終わり際）。at が "stop" の止まれ（関門）でも待つ
    （DESIGN-v0.1.2-handback §3.5）。
    戻り値: 待った場合 {"id", "target", "reason", "waited_ms"}、待たなかった場合 None。
    released 行は呼び出し側が配達のあとに書く（steer_ids を入れるため）"""
    ev = d.get("hook_event_name")
    if ev not in ("PreToolUse", "SubagentStop", "Stop"):
        return None
    target = target_of(d)
    pdir = os.path.join(run, "pause")
    pf = os.path.join(pdir, target + ".json")
    try:
        pause, st0 = read_pause(pf)
    except Exception as e:
        log_error(root, e, ev)
        return None
    if pause is None:
        return None
    at = pause.get("at") if pause.get("at") in ("next", "stop") else "next"
    kind = pause.get("kind") if pause.get("kind") in ("pause", "gate") else "pause"
    try:
        auto = float(pause.get("auto_resume_s"))
    except (TypeError, ValueError):
        auto = PAUSE_AUTO
    auto = min(max(auto, PAUSE_AUTO_MIN), PAUSE_AUTO_MAX)
    if ev == "PreToolUse" and at != "next" and not at_end:
        return None  # 終わる直前だけの止まれ（関門）は道具では止めない（handback の直前は終わり際なので止める）
    side = os.path.join(pdir, target + ".hit.json")
    start = time.time()
    deadline, mine = claim_hit(side, pause, auto, d, ev)
    info = {"id": pause["id"], "target": target}
    if mine:
        try:
            hook_line(run, d, {"pause": {"id": pause["id"], "phase": "hit", "kind": kind, "at": at,
                                         "target": target, "deadline": iso_of(deadline)}})
        except Exception as e:
            log_error(root, e, ev)
    mw = max_wait_arg(argv)
    cap = min(deadline, start + mw) if mw is not None else deadline

    def on_signal(_signum, _frame):
        # Claude Code が終わる・timeout を超えた：記録を 1 行残して、何も出さずに抜ける（道具はそのまま動く）
        try:
            hook_line(run, d, {"pause": {"id": pause["id"], "phase": "aborted", "target": target,
                                         "waited_ms": int((time.time() - start) * 1000)}})
        except Exception:
            pass
        try:
            os.remove(side)  # 次の hook が新しく止まった印を作り直せるように
        except OSError:
            pass
        os._exit(0)

    sigs = [x for x in (getattr(signal, "SIGTERM", None), getattr(signal, "SIGHUP", None)) if x is not None]
    old = {}
    for sg in sigs:
        try:
            old[sg] = signal.signal(sg, on_signal)
        except Exception:
            pass
    reason = None
    try:
        while True:
            if not same_file(pf, st0):
                reason = "user"
                break
            now = time.time()
            if now >= deadline:
                reason = "auto"
            elif now >= cap:
                reason = "max_wait"
            if reason:
                if same_file(pf, st0):
                    try:
                        os.remove(pf)
                    except OSError:
                        pass
                break
            time.sleep(min(PAUSE_TICK, max(0.0, cap - now) + 0.001))
    finally:
        for sg, h in old.items():
            try:
                signal.signal(sg, h)
            except Exception:
                pass
    try:
        os.remove(side)
    except OSError:
        pass
    if reason in ("auto", "max_wait"):
        clear_pause_flag(root)
    info["reason"] = reason
    info["waited_ms"] = int((time.time() - start) * 1000)
    return info


def take_steers(run, target):
    """<run>/steer/ の <target>-<ms>.json を ms 順に取る（先に rename して取り合う＝二重配達しない）。
    戻り値: [(steer_id, 本文)]。取れたものは <id>.delivered.json に名前を変える"""
    sdir = os.path.join(run, "steer")
    try:
        names = os.listdir(sdir)
    except OSError:
        return []
    pat = re.compile("^" + re.escape(target) + r"-(\d+)\.json$")
    cands = sorted((int(m.group(1)), n) for n in names for m in [pat.match(n)] if m)
    out = []
    for _ms, name in cands:
        src = os.path.join(sdir, name)
        sid = name[:-len(".json")]
        try:
            if os.stat(src).st_size > STEER_BYTES:
                continue  # 大きすぎるものは読まない（Neovim の掃除で期限切れになる）
        except OSError:
            continue
        tmp = os.path.join(sdir, sid + ".delivering.%d" % os.getpid())
        try:
            os.rename(src, tmp)
        except OSError:
            continue  # 同時に動いた別の hook が取った
        try:
            with open(tmp, "rb") as f:
                obj = json.loads(f.read(STEER_BYTES + 1))
            text = obj.get("text") if isinstance(obj, dict) else None
            if not isinstance(text, str) or not text.strip():
                raise ValueError("empty steer text")
        except Exception:
            try:
                os.rename(tmp, os.path.join(sdir, sid + ".broken.json"))
            except OSError:
                pass
            continue
        try:
            os.rename(tmp, os.path.join(sdir, sid + ".delivered.json"))
        except OSError:
            pass
        out.append((sid, text[:STEER_TEXT]))
    return out


def handback_stop(root, d, run):
    """handback で終わった子の SubagentStop（DESIGN-v0.1.2-handback §3.2）。block は出さない・待たない
    （Claude Code が捨てる。H3）。未配達の指示はファイル名を変えずに id だけ集めて skipped の 1 行、
    止まれがあれば消して released（reason handback_end）の 1 行。何も返さない"""
    ev = d.get("hook_event_name")
    target = target_of(d)
    sdir = os.path.join(run, "steer")
    try:
        names = os.listdir(sdir)
    except OSError:
        names = []
    pat = re.compile("^" + re.escape(target) + r"-(\d+)\.json$")
    ids = [n[:-len(".json")] for _ms, n in sorted((int(m.group(1)), n) for n in names for m in [pat.match(n)] if m)]
    if ids:
        try:
            hook_line(run, d, {"steer": {"ids": ids, "mode": "skipped", "reason": "handback", "target": target}})
        except Exception as e:
            log_error(root, e, ev)
    pdir = os.path.join(run, "pause")
    pf = os.path.join(pdir, target + ".json")
    try:
        pause, _st = read_pause(pf)
    except Exception as e:
        log_error(root, e, ev)
        pause = None
        try:
            os.remove(pf)  # 読めない止まれも、この子にはもう意味が無い
        except OSError:
            pass
    if pause is not None:
        try:
            os.remove(pf)
        except OSError:
            pass
        try:
            hook_line(run, d, {"pause": {"id": pause["id"], "phase": "released", "reason": "handback_end",
                                         "target": target}})
        except Exception as e:
            log_error(root, e, ev)
    try:
        os.remove(os.path.join(pdir, target + ".hit.json"))
    except OSError:
        pass
    clear_pause_flag(root)
    return None


def steer(root, d, run, argv, rec=None):
    """修正指示を配達する（--pause なら先に止まれを待つ）。配達したら hook の答え（JSON 文字列）を返す。何も無ければ None。
    rec: 同じ起動で記録係が作った 1 行（SubagentStop の report_via を見る。transcript を 2 回読まないため）"""
    ev = d.get("hook_event_name")
    is_hb_tool = ev == "PreToolUse" and d.get("tool_name") == HANDBACK_TOOL
    hb_route = opt_value(argv, "--handback")
    if hb_route not in HANDBACK_ROUTES:
        hb_route = None
    if is_hb_tool and hb_route is None:
        return None  # matcher 無しの門番：SubagentHandback は matcher 付きの門番に任せる（二重に待たない）
    if ev == "SubagentStop":
        if rec is not None:
            ended_hb = rec.get("report_via") == "handback"
        else:
            ended_hb = handback_ended(d, handback_report(d.get("agent_transcript_path")))
        if ended_hb:
            return handback_stop(root, d, run)
    paused = None
    if "--pause" in argv:
        try:
            paused = pause_wait(root, d, run, argv, at_end=is_hb_tool)
        except Exception as e:
            log_error(root, e, ev)  # 待ちの中の失敗は止まらない側に倒す
            paused = None
    mode = opt_value(argv, "--mode")
    if mode not in STEER_MODES:
        mode = "stop"  # 0.1.2 から既定は終わり際（DESIGN-v0.1.2-steer2 §3.2）
    used = None
    if is_hb_tool:
        # handback の直前：--handback deny のときだけ deny の理由で渡す（relay は親経由に任せ、ファイルは残す）
        used = "deny" if hb_route == "deny" else None
    elif ev in ("SubagentStop", "Stop"):
        # 終わり際で届ける：mode stop、v0.1.1 の --at-stop、止まれから解けた直後（関門の「直す」）
        if mode == "stop" or "--at-stop" in argv or paused:
            used = "block"
    elif ev == "PreToolUse":
        # mode stop では道具の直前に配達しない（止まれの待ちだけ。解けた直後でも何も出さない）
        used = mode if mode in ("deny", "context") else None
    target = target_of(d)
    got = []
    if used:
        try:
            got = take_steers(run, target)
        except Exception as e:
            log_error(root, e, ev)
    if paused:
        p = {"id": paused["id"], "phase": "released", "target": target, "reason": paused["reason"],
             "waited_ms": paused["waited_ms"]}
        if got:
            p["steer_ids"] = [i for i, _t in got]
        try:
            hook_line(run, d, {"pause": p})
        except Exception as e:
            log_error(root, e, ev)
    if not got:
        return None
    try:
        hook_line(run, d, {"steer": {"ids": [i for i, _t in got], "mode": used, "target": target}})
    except Exception as e:
        log_error(root, e, ev)
    msg = steer_message([t for _i, t in got], child=(target != "ROOT"),
                        paused_ms=paused["waited_ms"] if paused else None, at_stop=(used == "block"),
                        handback=is_hb_tool)
    if used == "block":
        out = {"decision": "block", "reason": msg}
    elif used == "context":
        out = {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "allow",
                                      "additionalContext": msg}}
    else:
        out = {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                      "permissionDecisionReason": msg}}
    return json.dumps(out, ensure_ascii=False)


def main():
    """記録する（ふだん）・修正指示を配達する（--steer）。標準出力に書くものを返す（無ければ None）"""
    argv = sys.argv[1:]
    want_steer = "--steer" in argv
    want_record = (not want_steer) or "--record" in argv
    root = None
    ev = None
    answer = None
    try:
        root = root_dir(argv)
        raw = sys.stdin.buffer.read(4 * 1024 * 1024)
        if not raw.strip():
            return None
        d = json.loads(raw)
        if not isinstance(d, dict):
            return None
        ev = d.get("hook_event_name")
        slug = safe_name(slug_of(d))
        pdir = os.path.join(root, "projects", slug)
        run = os.path.join(pdir, "runs", safe_name(d.get("session_id")))
    except Exception as e:
        log_error(root, e, ev)
        return None
    rec = None
    if want_record:
        try:
            os.makedirs(run, exist_ok=True)
            if ev == "SessionStart" or not os.path.exists(os.path.join(pdir, "project.json")):
                write_project(pdir, d, slug)
            rec = build(d)
            append(os.path.join(run, "hooks.jsonl"), encode(dict(rec)))
        except Exception as e:
            log_error(root, e, ev)
        if ev == "SessionEnd":
            try:
                end_session_cleanup(root, run)  # 記録のあと。失敗しても記録と Claude Code は止めない
            except Exception as e:
                log_error(root, e, ev)
    if want_steer:
        try:
            answer = steer(root, d, run, argv, rec)
        except Exception as e:
            log_error(root, e, ev)
    return answer


if __name__ == "__main__":
    try:
        _answer = main()
        if _answer:
            sys.stdout.write(_answer)  # 配達したときだけ（print は最後。配達したのに書けない、を作らない）
    except BaseException:
        pass
    try:
        sys.stdout.flush()
    except Exception:
        pass
    os._exit(0)
